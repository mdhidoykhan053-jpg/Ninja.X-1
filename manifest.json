{
  "manifest_version": 3,
  "name": "Ninja.X-1 - Quotex Round Number SNR Tracker",
  "version": "3.3.0",
  "description": "Ninja.X-1 Market Analysis Extension",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "*://*.market-qx.info/*",
    "*://*.qxbroker.com/*",
    "*://*.quotex.io/*",
    "*://*.quotex.com/*",
    "https://ninja-x-1-jenm-plum.vercel.app/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Ninja.X-1"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.market-qx.info/*",
        "*://*.qxbroker.com/*",
        "*://*.quotex.io/*",
        "*://*.quotex.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": [
        "*://*.market-qx.info/*",
        "*://*.qxbroker.com/*",
        "*://*.quotex.io/*",
        "*://*.quotex.com/*"
      ]
    }
  ]
}
